{
  "name": "life-os",
  "version": "0.1.0",
  "description": "Life OS — esqueleto Node.js/TypeScript com Todoist, Notion, Google Calendar e LangGraph.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/core/domain/result.test.ts src/infrastructure/daily-lock.test.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@doist/todoist-sdk": "^14.0.1",
    "@langchain/core": "^1.2.8",
    "@langchain/langgraph": "^1.4.10",
    "@langchain/openai": "^1.5.8",
    "@notionhq/client": "^5.25.2",
    "dotenv": "^17.4.2",
    "google-auth-library": "^11.0.2",
    "googleapis": "^175.0.0",
    "inversify": "^8.2.3",
    "langchain": "^1.5.9",
    "node-cron": "^4.6.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.23.12",
    "typescript": "~5.9.2"
  }
}

# Copie para .env na raiz. Nunca commite o .env.
# Nomes abaixo são os que o código lê hoje (src/ + inversify.config.ts).

# Todoist
TODOIST_API_TOKEN=

# Notion
NOTION_API_KEY=
NOTION_PROJECTS_DB_ID=

# Google Calendar (OAuth instalado)
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_INSTITUTO_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# LLM (LifeOsGraph)
OPENAI_API_KEY=
# opcional; default no código: gpt-4o-mini
OPENAI_MODEL=

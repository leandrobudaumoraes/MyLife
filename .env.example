# Copie para .env na raiz. Nunca commite o .env.
# Nomes abaixo são os que o código lê (src/ + inversify.config.ts).

# Todoist
TODOIST_API_TOKEN=

# Notion
NOTION_API_KEY=
NOTION_PROJECTS_DB_ID=
# opcional; parent para upsertChildPage
NOTION_DAILY_PLAN_PARENT_ID=

# Life OS
# 1 = reexecutar no mesmo DATE (ignora lock already_done)
LIFE_OS_FORCE=
# reservada (não usada no esqueleto)
LIFE_OS_PLANTAO=

# Google Calendar (OAuth instalado)
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_INSTITUTO_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# LLM (LifeOsGraph / OpenAiAdapter)
OPENAI_API_KEY=
# opcional; default no código: gpt-4o-mini
OPENAI_MODEL=
